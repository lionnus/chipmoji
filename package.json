{
  "name": "chipmoji",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "description": "An emoji guide for chip development commits.",
  "keywords": [
    "gitmoji",
    "chipmoji",
    "emoji",
    "commit",
    "hardware",
    "rtl",
    "verification",
    "asic",
    "fpga",
    "convention"
  ],
  "author": "Lionnus Kesting",
  "license": "Apache-2.0",
  "homepage": "https://chipmoji.lionn.us/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lionnus/chipmoji.git"
  },
  "bugs": {
    "url": "https://github.com/lionnus/chipmoji/issues"
  },
  "scripts": {
    "dev": "vite",
    "generate:txt": "node scripts/generate-chipmoji-txt.mjs",
    "generate:pdf": "node scripts/generate-chipmoji-pdf.mjs",
    "generate": "npm run generate:txt && npm run generate:pdf",
    "prebuild": "npm run generate",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.9.0",
    "puppeteer": "^25.5.0",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "puppeteer@24.43.1": true
  }
}
